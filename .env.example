# OpenRouter — required for receipt OCR
OPENROUTER_API_KEY=sk-or-...
# Vision model used to read receipts (any OpenRouter model id works)
OPENROUTER_MODEL=openai/gpt-5.4-mini

# Where the SQLite file lives. On Railway, point this at a mounted volume
# (e.g. /data/splitdumb.db) so tabs survive redeploys.
DATABASE_PATH=./splitdumb.db

# Server port (Railway sets PORT automatically)
PORT=3001

# Public base URL used to build share links / QR codes.
# Leave blank to infer from the incoming request.
PUBLIC_BASE_URL=
